# Copy this file to .env in the same folder (never commit .env).
# Used by docker compose for Postgres, API, dashboard, and optional demo agent.

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monitoring_db
POSTGRES_PORT=5432

PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# true only for local/demo. Never enable synchronize against a real shared DB.
# Production: set false and rely on migrations (see docs/PRODUCTION.md).
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

ALERT_CPU_THRESHOLD=80
ALERT_RAM_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
ALERT_COOLDOWN_MINUTES=5

# Optional. Leave empty to skip Telegram delivery.
TELEGRAM_BOT_TOKEN=

# Optional demo agent (docker compose --profile demo up -d --build).
# Register in the dashboard first, copy the org agent key, then paste it here.
AGENT_API_KEY=
AGENT_MACHINE_NAME=docker-agent
AGENT_POLLING_INTERVAL_SECONDS=30
