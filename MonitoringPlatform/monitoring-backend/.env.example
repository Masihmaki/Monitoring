# Copy to .env in this folder. Values must match MonitoringPlatform/.env for Postgres.

PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monitoring_db

# true only on a local machine / demo. Never enable synchronize against a real database.
# See docs/PRODUCTION.md before any shared deploy.
DB_SYNCHRONIZE=true

ALERT_CPU_THRESHOLD=80
ALERT_RAM_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
ALERT_COOLDOWN_MINUTES=5

# Required. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional. Bot token from @BotFather. Leave empty to skip Telegram delivery.
TELEGRAM_BOT_TOKEN=
